STAGE_FN = {"preflight": stage_preflight, "diffmap": stage_diffmap, "build": stage_build, "boot": stage_boot,
            "session": stage_session, "smoke": stage_smoke, "deep": stage_deep, "report": stage_report}


def pipeline(rid):
    rd = qalib.run_dir(rid)
    lockf = open(os.path.join(rd, "pipeline.lock"), "a+")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("ya hay un pipeline corriendo para esta corrida"); return 3
    qalib.update_state(rid, lambda s: s.update({"pipeline_pid": os.getpid()}))
    for stage in qalib.STAGES:
        st = qalib.load_state(rid)
        if st["stages"].get(stage, {}).get("status") in ("done", "skipped"):
            continue
        until = st.get("until") or None
        past = bool(until) and stage != "report" and qalib.STAGES.index(stage) > qalib.STAGES.index(until)
        qalib.set_stage(rid, stage, "running")
        qalib.log(rid, f"== etapa {stage}")
        t0 = time.time()
        try:
            if past:
                # El punto 12 del smoke vive al final de deep. Con --until smoke
                # se toma igual y el resto de deep no corre.
                if stage == "deep" and until == "smoke" and not st.get("skip_vm"):
                    qalib.log(rid, "journal del smoke (punto 12); deep no corre (--until smoke)")
                    from checks import smoke as smoke_mod
                    smoke_mod.journal(rid)
                qalib.set_stage(rid, stage, "skipped", seconds=round(time.time() - t0))
                continue
            res = STAGE_FN[stage](rid, st)
            qalib.set_stage(rid, stage, "skipped" if res == "skipped" else "done", seconds=round(time.time() - t0))
        except StageFail as e:
            qalib.set_stage(rid, stage, "failed", error=str(e), seconds=round(time.time() - t0))
            qalib.log(rid, f"etapa {stage} FALLÓ: {e}")
            write_report(rid)
            return 1
        except Exception as e:  # noqa: BLE001
            import traceback
            traceback.print_exc()
            qalib.set_stage(rid, stage, "failed", error=repr(e), seconds=round(time.time() - t0))
            write_report(rid)
            return 1
    qalib.log(rid, "pipeline terminado: " + verdict(rid)[0])
    return 0


# --------------------------------------------------------------------- informe
def verdict(rid):
    st = qalib.load_state(rid)
    rows = qalib.load_results(rid)
    d = {}
    p = os.path.join(qalib.run_dir(rid), "diffmap.json")
    if os.path.exists(p):
        d = json.load(open(p))
    reasons = []
    failed = [s for s, v in st["stages"].items() if v.get("status") == "failed"]
    fails = [r for r in rows if r["status"] == "FAIL"]
    if fails:
        reasons += [f"FAIL {r['phase']}/{r['id']}" for r in fails]
    if failed:
        reasons += [f"etapa {s} falló: {st['stages'][s].get('error', '')[:120]}" for s in failed]
    if fails or failed:
        return "RECHAZADO", reasons
    pending = [s for s in qalib.STAGES[:-1] if st["stages"].get(s, {}).get("status") not in ("done", "skipped")]
    if pending:
        return "EN CURSO", [f"etapas pendientes: {', '.join(pending)}"]
    notes = [f"{r['status']} {r['phase']}/{r['id']}" for r in rows if r["status"] in ("WARN", "SKIP")]
    notes += [f"UNMAPPED {f}" for f in d.get("unmapped", [])]
    notes += [f"aviso: {w}" for w in st.get("warnings", [])]
    if notes:
        return "NOTAS", notes
    return "APROBADO", []


def fmt_dur(sec):
    return "-" if sec is None else (f"{sec // 60}m{sec % 60:02d}s" if sec >= 60 else f"{sec}s")


def write_report(rid):
    rd = qalib.run_dir(rid); st = qalib.load_state(rid); rows = qalib.load_results(rid)
    d = json.load(open(os.path.join(rd, "diffmap.json"))) if os.path.exists(os.path.join(rd, "diffmap.json")) else {}
    v, reasons = verdict(rid)
    ev = lambda r: ", ".join(f"[{os.path.basename(e)}]({e})" for e in r.get("evidence", []))  # noqa: E731
    esc = lambda s: str(s).replace("|", "\\|").replace("\n", " ")  # noqa: E731
    L = [f"# churros-verify · {rid}", "",
         f"**Veredicto: {v}**", ""]
    L += [f"- {x}" for x in reasons[:30]] + ([""] if reasons else [])
    L += ["| Campo | Valor |", "|---|---|",
          f"| SHA | `{st['sha']}` ({st.get('ref', '')}) |",
          f"| Base | `{st['base']}` (merge-base `{d.get('merge_base', '')[:10]}`) |",
          f"| Edición / arch | {st['edition']} / {st['arch']} |",
          f"| Aceleración | {st.get('accel', '?')}{' (⚠ TCG, --allow-tcg)' if st.get('accel') == 'tcg' else ''} |",
          f"| 3D | {'sí' if st.get('has_3d') else 'no (Niri anidado en cage)'} |",
          f"| Hasta | {st.get('until') or 'report'} |",
          f"| ISO | `{st.get('iso')}` — {st.get('iso_source', '')} |",
          f"| Arranque hasta login | {fmt_dur(st.get('boot_seconds'))} |",
          f"| Inicio | {st['created']} |", ""]
    L += ["## Etapas", "", "| Etapa | Estado | Duración |", "|---|---|---|"]
    for s in qalib.STAGES:
        x = st["stages"].get(s, {})
        L.append(f"| {s} | {x.get('status', 'pendiente')}{(' — ' + esc(x['error'])[:120]) if x.get('error') else ''} | {fmt_dur(x.get('seconds'))} |")
    from checks.smoke import SMOKE
    by = {(r["phase"], r["id"]): r for r in rows}
    L += ["", "## Smoke (12 puntos)", "", "| # | Punto | Estado | Detalle | Evidencia |", "|---|---|---|---|---|"]
    for cid, title in SMOKE:
        r = by.get(("smoke", cid))
        L.append(f"| {cid[:2]} | {title} | {r['status'] if r else '—'} | {esc(r['detail'])[:220] if r else ''} | {ev(r) if r else ''} |")
    L += ["", "## Pruebas del diff (qa-diffmap)", ""]
    if d:
        L += [f"Archivos cambiados: {len(d['files'])} · features: {', '.join(f['id'] for f in d['features']) or '—'}"
              f" · docs: {len(d['docs_files'])}{' (solo docs)' if d['docs_only'] else ''}", ""]
    L += ["| Check | Estado | Detalle | Evidencia |", "|---|---|---|---|"]
    for r in [r for r in rows if r["phase"] == "deep"]:
        L.append(f"| {r['id']} | {r['status']} | {esc(r['detail'])[:260]} | {ev(r)} |")
    L += ["", "### UNMAPPED", ""]
    L += [f"- `{f}`" for f in d.get("unmapped", [])] or ["- (ninguno)"]
    L += ["", "## Build", ""]
    for r in [r for r in rows if r["phase"] in ("build", "meta")]:
        L.append(f"- **{r['id']}**: {r['status']} — {esc(r['detail'])[:300]} {ev(r)}")
    if st.get("warnings"):
        L += ["", "## Avisos", ""] + [f"- {w}" for w in st["warnings"]]
    L += ["", "## Logs", "", "- `progress.log`, `results.jsonl`, `state.json`, `diffmap.json`",
          "- `vm/serial.log` (consola serie), `agent/jobs.log` (comandos en el invitado), `logs/` (check, build, qemu)",
          "- `evidence/` (journal, noctalia.log, niri-nested.log), `shots/` (capturas QMP)", ""]
    open(os.path.join(rd, "report.md"), "w").write("\n".join(L))
    return v


# ------------------------------------------------------------------------ CLI
def new_run(a):
    sha = sh(["git", "-C", qalib.REPO, "rev-parse", "--verify", a.sha + "^{commit}"])
    if sha.returncode:
        raise SystemExit(f"no encuentro {a.sha} en {qalib.REPO} (haz git fetch antes)")
    sha = sha.stdout.strip()
    rid = a.run_id or time.strftime("%Y%m%d-%H%M%S") + f"-{sha[:7]}-{a.edition}"
    rd = qalib.run_dir(rid)
    for sub in ("vm", "logs", "shots", "evidence", "agent"):
        os.makedirs(os.path.join(rd, sub), exist_ok=True)
    if not os.path.exists(os.path.join(rd, "state.json")):
        qalib.save_state(rid, {"run_id": rid, "sha": sha, "ref": a.sha, "base": a.base, "edition": a.edition,
                               "arch": a.arch, "allow_tcg": a.allow_tcg, "wait_other_vms": a.wait_other_vms, "keep_vm": a.keep_vm, "rebuild": a.rebuild,
                               "until": a.until or None,
                               "created": qalib.now(), "warnings": [], "stages": {s: {"status": "pending"} for s in qalib.STAGES}})
    latest = os.path.join(qalib.RUNS, "latest")
    if os.path.islink(latest) or os.path.exists(latest):
        os.remove(latest)
    os.symlink(rid, latest)
    return rid


def launch(rid, fg):
    if fg:
        return pipeline(rid)
    log = open(os.path.join(qalib.run_dir(rid), "pipeline.log"), "a")
    p = subprocess.Popen([sys.executable, ME, "resume", rid, "--fg"], stdout=log, stderr=log,
                         stdin=subprocess.DEVNULL, start_new_session=True)
    print(f"RUN_ID={rid}\npipeline en segundo plano (pid {p.pid})\n"
          f"  progreso: tail -f {qalib.run_dir(rid)}/progress.log\n"
          f"  estado:   {ME} status {rid}\n  retomar:  {ME} resume {rid}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="churros-verify", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("preflight"); p.add_argument("--allow-tcg", action="store_true")
    p = sub.add_parser("run")
    p.add_argument("sha"); p.add_argument("--edition", default="niri"); p.add_argument("--arch", default="x86_64")
    p.add_argument("--base", default=os.environ.get("QA_BASE", "origin/main"))
    p.add_argument("--allow-tcg", action="store_true"); p.add_argument("--keep-vm", action="store_true")
    p.add_argument("--until", choices=qalib.STAGES, default="",
                   help="termina al acabar esta etapa; con smoke incluye el journal (punto 12) y salta deep")
    p.add_argument("--rebuild", action="store_true"); p.add_argument("--fg", action="store_true")
    p.add_argument("--wait-other-vms", action="store_true", help="antes de arrancar la VM, espera a que no haya otra QEMU")
    p.add_argument("--run-id")
    for name in ("resume", "status", "report", "stop"):
        p = sub.add_parser(name); p.add_argument("run_id", nargs="?")
        if name == "resume":
            p.add_argument("--fg", action="store_true"); p.add_argument("--from", dest="from_stage")
            p.add_argument("--redo", help="repite puntos concretos: smoke:09-lock,deep:wallpaper-apply-noctalia")
    p = sub.add_parser("diffmap"); p.add_argument("sha"); p.add_argument("--base", default="origin/main")
    p.add_argument("--edition", default="niri")
    p = sub.add_parser("cache-iso"); p.add_argument("sha"); p.add_argument("iso")
    p.add_argument("--edition", default="niri"); p.add_argument("--arch", default="x86_64")
    sub.add_parser("checks")
    a = ap.parse_args()

    if a.cmd == "preflight":
        ok, notes, fatal, _kvm, _has_3d = preflight(a.allow_tcg)
        for n, good, msg in notes:
            print(f"{'ok ' if good else 'NO '} {n}: {msg}")
        print("PREFLIGHT " + ("OK" if ok else "FALLA: " + "; ".join(fatal)))
        return 0 if ok else 2
    if a.cmd == "run":
        return launch(new_run(a), a.fg)
    if a.cmd == "diffmap":
        return subprocess.call([sys.executable, os.path.join(QA, "lib", "diffmap.py"), a.sha, "--base", a.base, "--edition", a.edition])
    if a.cmd == "checks":
        from checks.deep import CHECKS
        for k, (t, _) in CHECKS.items():
            print(f"{k:28} {t}")
        return 0
    if a.cmd == "cache-iso":
        sha = sh(["git", "-C", qalib.REPO, "rev-parse", a.sha + "^{commit}"]).stdout.strip()
        dst = iso_cache_path(sha, a.edition, a.arch)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        subprocess.run(["cp", "--reflink=auto", a.iso, dst], check=True)
        json.dump({"sha": sha, "source": f"importada de {a.iso}", "imported": qalib.now(), "sha256": sha256(dst)},
                  open(dst + ".json", "w"), indent=2)
        print(dst); return 0
    rid = qalib.resolve_run(a.run_id)
    if a.cmd == "resume":
        if a.redo:
            for item in a.redo.split(","):
                phase, _, cid = item.partition(":")
                qalib.add_result(rid, phase, cid, cid, "REDO", "se repite a pedido (--redo)")
                stage = "smoke" if phase == "smoke" else "deep"
                qalib.update_state(rid, lambda s: s["stages"].__setitem__(stage, {"status": "pending"}))
                qalib.update_state(rid, lambda s: s["stages"].__setitem__("report", {"status": "pending"}))
        if a.from_stage:
            def reset(s):
                hit = False
                for x in qalib.STAGES:
                    hit = hit or x == a.from_stage
                    if hit:
                        s["stages"][x] = {"status": "pending"}
            qalib.update_state(rid, reset)
        else:  # una etapa "running" de un pipeline muerto se vuelve a correr
            qalib.update_state(rid, lambda s: [v.update({"status": "pending"}) for v in s["stages"].values() if v.get("status") in ("running", "failed")])
        return launch(rid, a.fg)
    if a.cmd == "status":
        st = qalib.load_state(rid)
        print(f"RUN_ID={rid} sha={st['sha'][:10]} accel={st.get('accel')} pipeline_pid={st.get('pipeline_pid')} "
              f"(vivo={qalib.pid_alive(st.get('pipeline_pid') or 0)}) qemu_pid={st.get('qemu_pid')}")
        for s in qalib.STAGES:
            x = st["stages"].get(s, {})
            print(f"  {s:10} {x.get('status', '?'):8} {fmt_dur(x.get('seconds'))} {x.get('error', '')[:100]}")
        print("veredicto:", verdict(rid)[0])
        print(sh(f"tail -5 {qalib.run_dir(rid)}/progress.log").stdout)
        return 0
    if a.cmd == "report":
        v = write_report(rid)
        print(f"{qalib.run_dir(rid)}/report.md\nVEREDICTO: {v}")
        return 0
    if a.cmd == "stop":
        st = qalib.load_state(rid)
        if st.get("pipeline_pid") and qalib.pid_alive(st["pipeline_pid"]):
            qalib.kill_pid(st["pipeline_pid"])
        subprocess.run([sys.executable, os.path.join(QA, "vm-up"), rid, "--down"])
        return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
