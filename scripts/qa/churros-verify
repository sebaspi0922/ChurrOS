#!/usr/bin/env python3
"""churros-verify: QA de una rama/SHA de ChurrOS de punta a punta.

  churros-verify preflight [--allow-tcg]
  churros-verify run SHA [--edition niri] [--base origin/main] [--allow-tcg] [--keep-vm] [--fg] [--until smoke] [--run-id ID]
  churros-verify resume [RUN_ID] [--fg]      retoma desde la primera etapa sin terminar
  churros-verify status [RUN_ID]             etapas, último progreso
  churros-verify report [RUN_ID]             regenera report.md y muestra el veredicto
  churros-verify stop [RUN_ID]               para la VM, el servidor y el pipeline
  churros-verify diffmap SHA [--base ..]     qué pruebas tocan para ese diff
  churros-verify cache-iso SHA ISO [--edition niri] [--arch x86_64]
  churros-verify checks                      lista de checks profundos

Sin --fg, run/resume dejan el pipeline en segundo plano (setsid) y vuelven
enseguida: las tareas de los agentes se cortan a los 15 min, el pipeline no.
Etapas: preflight diffmap build boot session smoke deep report."""
import argparse, contextlib, fcntl, fnmatch, glob, hashlib, json, os, re, shutil, subprocess, sys, time

QA = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(QA, "lib")); sys.path.insert(0, QA)
import qalib  # noqa: E402
import diffmap as dm  # noqa: E402

ME = os.path.abspath(__file__)
TRANSIENT = [r"Could not resolve host", r"Temporary failure in name resolution", r"Resolving timed out",
             r"failed retrieving file", r"download library error", r"Operation too slow",
             r"Connection (timed out|reset|refused)", r"failed to synchronize all databases",
             r"curl: \((6|7|18|28|35|56)\)", r"failed to retrieve some files", r"TLS handshake",
             r"returned error: (429|5\d\d)", r"fatal: unable to access", r"keyserver receive failed",
             r"Network is unreachable", r"error: failed to download"]
STALE_DB = [r"error: target not found", r"returned error: 404", r"database file for .* does not exist",
            r"could not open file .*\.db"]


def sh(cmd, **kw):
    return subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, **kw)


def iso_cache_path(sha, edition, arch):
    return os.path.join(qalib.CACHE, "iso", f"ChurrOS-{sha[:12]}-{edition}-{arch}.iso")


# ------------------------------------------------------------------ preflight
def kvm_usable():
    """/dev/kvm usable de verdad: además de abrirlo, arranca una QEMU mínima con
    KVM y le pide `query-status` por QMP (el bucle principal solo responde si se
    crearon los vCPU). En este box /dev/kvm existe y KVM_CREATE_VM funciona,
    pero la creación del vCPU se cuelga; por eso la prueba es con QEMU real.
    El resultado se guarda por arranque del host (boot_id) para no repetirla."""
    if not os.path.exists("/dev/kvm"):
        return False, "/dev/kvm no existe"
    if not os.access("/dev/kvm", os.R_OK | os.W_OK):
        return False, "/dev/kvm sin permiso de lectura/escritura"
    boot_id = open("/proc/sys/kernel/random/boot_id").read().strip()
    cache = os.path.join(qalib.CACHE, "kvm-probe.json")
    try:
        c = json.load(open(cache))
        if c.get("boot_id") == boot_id and not os.environ.get("QA_KVM_REPROBE"):
            return c["ok"], c["msg"] + " (en caché para este arranque del host)"
    except Exception:
        pass
    sock = f"/tmp/churros-verify-kvmprobe-{os.getpid()}.sock"
    p = subprocess.Popen(["qemu-system-x86_64", "-M", "q35,accel=kvm", "-cpu", "host", "-m", "128",
                          "-display", "none", "-nodefaults", "-S", "-qmp", f"unix:{sock},server=on,wait=off"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL)
    ok, msg = False, "QEMU con KVM no respondió a query-status en 15 s (vCPU colgado)"
    t0 = time.time()
    while time.time() - t0 < 15 and p.poll() is None:
        try:
            import socket
            s = socket.socket(socket.AF_UNIX); s.settimeout(3); s.connect(sock)
            f = s.makefile("rb"); f.readline()
            s.sendall(b'{"execute":"qmp_capabilities"}\n'); f.readline()
            s.sendall(b'{"execute":"query-status"}\n')
            r = f.readline()
            if b"return" in r:
                ok, msg = True, "QEMU+KVM responde (vCPU creado)"
            s.close()
            break
        except (OSError, socket.timeout):
            time.sleep(0.5)
    if p.poll() is not None and not ok:
        msg = "QEMU con KVM salió: " + p.stderr.read().decode(errors="replace").strip()[-200:]
    p.kill()
    with contextlib.suppress(Exception):
        p.wait(timeout=10)
    with contextlib.suppress(Exception):
        os.remove(sock)
    os.makedirs(qalib.CACHE, exist_ok=True)
    json.dump({"boot_id": boot_id, "ok": ok, "msg": msg, "when": qalib.now()}, open(cache, "w"))
    return ok, msg


def gpu_3d_usable():
    """3D del host, aparte de KVM. ./churros run elige virtio-vga-gl si existe
    /dev/dri. Sin eso Niri no pinta en la TTY y el smoke lo anida en cage.
    KVM no implica 3D: un runner con /dev/kvm y sin GPU sigue usando cage."""
    if os.environ.get("QA_FORCE_NO3D") == "1":
        return False, "QA_FORCE_NO3D=1"
    if os.path.isdir("/dev/dri"):
        nodes = sorted(os.listdir("/dev/dri"))
        detail = "/dev/dri presente" + (f" ({', '.join(nodes)})" if nodes else "")
        return True, detail
    return False, "/dev/dri no existe"


def preflight(allow_tcg):
    notes, fatal = [], []
    kvm_ok, kvm_msg = kvm_usable()
    d3_ok, d3_msg = gpu_3d_usable()
    notes.append(("kvm", kvm_ok, kvm_msg))
    notes.append(("3d", d3_ok, d3_msg))
    if not kvm_ok and not allow_tcg:
        fatal.append(f"sin KVM ({kvm_msg}); usa --allow-tcg para seguir con emulación (lento, ~12 min hasta el login)")
    for tool in ("qemu-system-x86_64", "qemu-img", "git", "convert", "curl"):
        p = shutil.which(tool)
        notes.append((tool, bool(p), p or "falta"))
        if not p:
            fatal.append(f"falta {tool}")
    ovmf = any(os.path.exists(p) for p in ("/usr/share/OVMF/OVMF_CODE_4M.fd", "/usr/share/edk2/x64/OVMF_CODE.4m.fd",
                                           "/usr/share/OVMF/OVMF_CODE.fd"))
    notes.append(("ovmf", ovmf, "ok" if ovmf else "falta"))
    if not ovmf:
        fatal.append("falta OVMF")
    os.makedirs(qalib.CACHE, exist_ok=True)
    free = shutil.disk_usage(qalib.CACHE).free / 2**30
    notes.append(("disco", free > 15, f"{free:.0f} GiB libres en {qalib.CACHE}"))
    if free < 15:
        fatal.append("menos de 15 GiB libres")
    others = sh("pgrep -a qemu-system").stdout.strip()
    notes.append(("otras VMs", not others, others.replace("\n", " ; ")[:200] or "ninguna"))
    return (not fatal), notes, fatal, kvm_ok, d3_ok


# --------------------------------------------------------------------- etapas
def stage_preflight(rid, st):
    ok, notes, fatal, kvm, has_3d = preflight(st["allow_tcg"])
    for n, good, msg in notes:
        qalib.log(rid, f"preflight {n}: {'ok' if good else 'NO'} - {msg}")
    qalib.update_state(rid, lambda s: s.update({"accel": "kvm" if kvm else "tcg", "has_3d": has_3d}))
    if not kvm and st["allow_tcg"]:
        qalib.warn(rid, "sin KVM: la VM corrió con TCG (--allow-tcg); tiempos no representativos")
    if not has_3d:
        qalib.log(rid, "sin 3D: Niri del smoke se anida en cage (KVM no implica 3D)")
    if notes[-1][1] is False:
        qalib.log(rid, "nota: hay otras VMs corriendo (no bloquea): " + notes[-1][2])
    if not ok:
        qalib.add_result(rid, "meta", "preflight", "Preflight", "FAIL", "; ".join(fatal))
        raise StageFail("; ".join(fatal))
    qalib.add_result(rid, "meta", "preflight", "Preflight", "PASS", notes[0][2])


def stage_diffmap(rid, st):
    d = dm.compute(st["sha"], st["base"], st["edition"])
    json.dump(d, open(os.path.join(qalib.run_dir(rid), "diffmap.json"), "w"), indent=2, ensure_ascii=False)
    qalib.log(rid, f"diffmap: {len(d['files'])} archivos, features={[f['id'] for f in d['features']]}, "
                   f"unmapped={len(d['unmapped'])}, docs_only={d['docs_only']}")


class StageFail(Exception):
    pass


def ensure_src(sha):
    src = os.path.join(qalib.CACHE, "src", sha[:12])
    if not os.path.isdir(src):
        os.makedirs(os.path.dirname(src), exist_ok=True)
        r = sh(["git", "-C", qalib.REPO, "worktree", "add", "--detach", src, sha])
        if r.returncode:
            raise StageFail("git worktree add: " + r.stderr)
    return src


def classify(log_text):
    tail = "\n".join(log_text.splitlines()[-400:])
    for rx in STALE_DB:
        if re.search(rx, tail):
            return "stale_db", rx
    for rx in TRANSIENT:
        if re.search(rx, tail):
            return "transient", rx
    return "fatal", None


def stage_build(rid, st):
    rd = qalib.run_dir(rid); sha = st["sha"]
    d = json.load(open(os.path.join(rd, "diffmap.json")))
    src = ensure_src(sha)
    # ./churros check (estático, rápido) antes del build
    if "check" not in qalib.done_ids(rid, "build"):
        t0 = time.time()
        r = sh(f"cd {src} && ./churros check > {rd}/logs/check.log 2>&1; echo $?")
        rc = int(r.stdout.strip() or 1)
        fails = sh(f"grep -E '✗|FAIL|Error' {rd}/logs/check.log | head -5").stdout.strip()
        qalib.add_result(rid, "build", "check", "./churros check", "PASS" if rc == 0 else "FAIL",
                         f"rc={rc}" + (f"; {fails}" if fails else ""), ["logs/check.log"], time.time() - t0)
    cache = iso_cache_path(sha, st["edition"], st["arch"])
    if os.path.exists(cache) and not st.get("rebuild"):
        meta = cache + ".json"
        src_note = json.load(open(meta)).get("source", "build") if os.path.exists(meta) else "caché"
        qalib.update_state(rid, lambda s: s.update({"iso": cache, "iso_source": f"caché ({src_note})"}))
        qalib.add_result(rid, "build", "iso", "ISO", "PASS", f"reutilizada de la caché por SHA: {cache} ({src_note})")
        return
    if d["docs_only"]:
        base_iso = iso_cache_path(d["merge_base"], st["edition"], st["arch"])
        if os.path.exists(base_iso):
            qalib.update_state(rid, lambda s: s.update({"iso": base_iso, "iso_source": "ISO de la base (diff solo docs)"}))
            qalib.add_result(rid, "build", "iso", "ISO", "SKIP", "diff solo docs: build saltado, se usa la ISO de la base")
        else:
            qalib.update_state(rid, lambda s: s.update({"iso": None, "skip_vm": True}))
            qalib.add_result(rid, "build", "iso", "ISO", "SKIP", "diff solo docs: build y VM saltados")
        return
    lock = open(os.path.join(qalib.CACHE, "build.lock"), "a+")
    qalib.log(rid, "esperando el candado de build (un build a la vez en esta máquina)")
    fcntl.flock(lock, fcntl.LOCK_EX)
    retries = int(os.environ.get("QA_BUILD_RETRIES", 3))
    env = dict(os.environ)
    env.setdefault("CHURROS_CONTAINER_ARGS", "--network=host")
    for attempt in range(1, retries + 1):
        for old in glob.glob(os.path.join(src, "out", "*.iso")):
            os.remove(old)
        blog = os.path.join(rd, "logs", f"build-{attempt}.log")
        qalib.log(rid, f"build intento {attempt}/{retries} -> logs/build-{attempt}.log")
        t0 = time.time()
        with open(blog, "w") as f:
            rc = subprocess.run(["./churros", "build", "--container", "--edition", st["edition"], "--arch", st["arch"]],
                                cwd=src, stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, env=env).returncode
        isos = glob.glob(os.path.join(src, "out", "*.iso"))
        if rc == 0 and isos:
            os.makedirs(os.path.dirname(cache), exist_ok=True)
            shutil.move(isos[0], cache)
            json.dump({"sha": sha, "source": f"build {rid}", "built": qalib.now(),
                       "sha256": sha256(cache)}, open(cache + ".json", "w"), indent=2)
            qalib.update_state(rid, lambda s: s.update({"iso": cache, "iso_source": "build"}))
            qalib.add_result(rid, "build", "iso", "ISO", "PASS", f"intento {attempt}, {time.time() - t0:.0f}s -> {cache}",
                             [f"logs/build-{attempt}.log"], time.time() - t0)
            return
        kind, rx = classify(open(blog, errors="replace").read())
        qalib.log(rid, f"build rc={rc}: {kind} ({rx})")
        if kind == "fatal" or attempt == retries:
            qalib.add_result(rid, "build", "iso", "ISO", "FAIL", f"rc={rc} {kind} {rx or ''} (intento {attempt})",
                             [f"logs/build-{attempt}.log"], time.time() - t0)
            raise StageFail(f"build falló ({kind})")
        if kind == "stale_db":
            # DB vieja: pacman -Sy en el host si es Arch; en contenedor, imagen nueva
            # (el entrypoint ya hace pacman -Sy al arrancar).
            if shutil.which("pacman"):
                sh("sudo -n pacman -Sy --noconfirm")
            env["CHURROS_CONTAINER_REBUILD"] = "1"
            qalib.warn(rid, f"build: DB de paquetes vieja ({rx}); pacman -Sy / imagen del contenedor regenerada y reintento")
        else:
            time.sleep(30 * attempt)


def sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def stage_boot(rid, st):
    if st.get("skip_vm"):
        return "skipped"
    if st.get("wait_other_vms") and not (st.get("qemu_pid") and qalib.pid_alive(st["qemu_pid"])):
        t0 = time.time()
        while sh(["pgrep", "^qemu-system"]).stdout.strip():
            if time.time() - t0 > 6 * 3600:
                raise StageFail("otra VM de QEMU sigue corriendo tras 6 h")
            qalib.log(rid, "esperando a que termine otra VM de QEMU (--wait-other-vms)") if int(time.time() - t0) % 600 < 30 else None
            time.sleep(30)
        if time.time() - t0 > 5:
            qalib.log(rid, f"otras VMs terminadas tras {time.time() - t0:.0f}s de espera")
    r = subprocess.run([sys.executable, os.path.join(QA, "vm-up"), rid])
    if r.returncode:
        raise StageFail("vm-up falló")
    st = qalib.load_state(rid)
    tmo = 900 if st["accel"] == "kvm" else 2400
    t0 = time.time()
    ok, m = qalib.wait_until(rid, serial=r"login:", timeout=tmo, interval=3, since=0)
    if not ok:
        raise StageFail(f"sin prompt de login en la consola serie tras {tmo}s")
    qalib.update_state(rid, lambda s: s.__setitem__("boot_seconds", round(time.time() - t0)))


def serial_quiet(rid, secs=3, timeout=60):
    t0 = time.time(); last = -1; since = time.time()
    while time.time() - t0 < timeout:
        n = qalib.serial_size(rid)
        if n != last:
            last, since = n, time.time()
        elif time.time() - since >= secs:
            return
        time.sleep(0.5)


def _probe_shell(rid, timeout=12):
    off = qalib.serial_size(rid)
    qalib.serial_send(rid, "echo QA_SH_$((40+1))\r")
    ok, m = qalib.wait_until(rid, serial=r"QA_SH_41|Password:", timeout=timeout, since=off)
    if ok and "Password" in m:  # el eco cayó como usuario: abortar ese login
        qalib.serial_send(rid, "\r")
        qalib.wait_until(rid, serial=r"login: *$", timeout=40, since=off)
        return False
    return ok


def serial_shell(rid, user="churros"):
    """Shell en ttyS0 como el usuario live (sin contraseña; root no puede entrar
    por serie, pero el usuario live tiene sudo sin contraseña). Notas de la
    consola: agetty manda consultas a la terminal al arrancar y puede comerse
    la primera línea; zsh tarda en pintar el prompt con TCG. Por eso todo se
    confirma con un eco y se reintenta."""
    if _probe_shell(rid):
        return True
    for _ in range(6):
        serial_quiet(rid)
        off = qalib.serial_size(rid)
        qalib.serial_send(rid, user + "\r")
        ok, m = qalib.wait_until(rid, serial=r"Password:|Last login|\u276f|\$ *$|# *$", timeout=25, since=off)
        if ok and "Password" in m:
            qalib.serial_send(rid, "\r")
        serial_quiet(rid, secs=3, timeout=40)
        if _probe_shell(rid, timeout=20):
            return True
    return False


def stage_session(rid, st):
    if st.get("skip_vm"):
        return "skipped"
    subprocess.run([sys.executable, os.path.join(QA, "vm-up"), rid], check=True)  # idempotente
    st = qalib.load_state(rid)
    if not qalib.agent_alive(rid):
        port = st["http_port"]
        H = f"http://10.0.2.2:{port}"
        for attempt in range(4):
            if not serial_shell(rid):
                qalib.log(rid, f"login por serie sin shell (intento {attempt + 1})")
                continue
            off = qalib.serial_size(rid)
            qalib.serial_send(rid, f"sudo -n sh -c 'curl -sf -m 20 --retry 40 --retry-delay 2 --retry-all-errors {H}/f/agent.sh -o /run/qa-agent.sh "
                                   f"&& (setsid bash /run/qa-agent.sh {H} >/dev/null 2>&1 < /dev/null &)' ; "
                                   f"echo QA_BOOT_$((6*7))\r")
            qalib.wait_until(rid, serial=r"QA_BOOT_42", timeout=150, since=off)
            for _ in range(60):
                if qalib.agent_alive(rid):
                    break
                time.sleep(1)
            if qalib.agent_alive(rid):
                break
            qalib.log(rid, f"agente no responde (intento {attempt + 1})")
        else:
            raise StageFail("no se pudo arrancar el agente del invitado por la consola serie")
        # el host para que el invitado suba evidencia
        qalib.guest_cmd(rid, f"mkdir -p /run/qa && echo {H} > /run/qa/host && chmod 644 /run/qa/host", timeout=20)
    rc, out = qalib.guest_cmd(rid, "uname -r; cat /etc/os-release | grep ^PRETTY; ip -4 -br a | grep -v lo", timeout=30)
    qalib.log(rid, "agente listo: " + out.strip().replace("\n", " | "))


